PORT=5000
NODE_ENV=development

# Firebase Admin Configuration
# Cách 1: Đường dẫn file serviceAccountKey.json tải từ Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Cách 2: Tên Firebase Storage Bucket (ví dụ: your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=prj-van-hoa.appspot.com

# AI Computer Vision Service URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# TTS (Text to Speech) Configuration (Tùy chọn: Google Cloud TTS hoặc FPT AI)
TTS_API_KEY=your_tts_api_key_here
